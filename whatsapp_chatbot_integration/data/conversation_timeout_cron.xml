<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Parámetro del sistema para el intervalo del cron -->
        <record id="ir_config_parameter_cron_interval" model="ir.config_parameter">
            <field name="key">chat_wapp.cron_cleanup_interval_minutes</field>
            <field name="value">5</field>
        </record>

        <!-- Cron job para limpiar conversaciones expiradas -->
        <record id="ir_cron_clean_expired_conversations" model="ir.cron">
            <field name="name">Limpiar conversaciones expiradas de WhatsApp</field>
            <field name="model_id" ref="model_conversation_timeout_cron" />
            <field name="state">code</field>
            <field name="code">model._clean_expired_conversations()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True" />
        </record>
    </data>
</odoo> 